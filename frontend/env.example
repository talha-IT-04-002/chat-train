# Frontend Environment Configuration
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=ChatTrain
VITE_APP_VERSION=1.0.0

# Frontend URL (used by backend for email verification links)
VITE_FRONTEND_URL=http://localhost:5173

# Email Verification Configuration
VITE_EMAIL_VERIFICATION_ENABLED=true
VITE_EMAIL_VERIFICATION_TIMEOUT=24

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG_MODE=true
VITE_USE_MOCKS=true

# Email Settings
VITE_SUPPORT_EMAIL=support@chattrain.com
VITE_EMAIL_TEMPLATE_BRAND=ChatTrain
