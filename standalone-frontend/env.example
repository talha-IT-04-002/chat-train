# Standalone Frontend Environment Configuration
# This frontend runs independently without a backend

# Mock API Configuration (enabled by default for standalone operation)
VITE_USE_MOCKS=true
VITE_BYPASS_EMAIL_VERIFICATION=true

# App Configuration
VITE_APP_NAME=ChatTrain Standalone
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG_MODE=true

# Email Settings (for display purposes only)
VITE_SUPPORT_EMAIL=support@chattrain.com
VITE_EMAIL_TEMPLATE_BRAND=ChatTrain

# Demo Credentials (for mock login)
# Email: demo@example.com
# Password: demo123

# Optional: Connect to real backend (set VITE_USE_MOCKS=false and VITE_API_BASE_URL)
# VITE_API_BASE_URL=http://localhost:5000/api
